<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<LangVersion>12.0</LangVersion>
		<PackageId>Endfix.Telegram.BotAPI</PackageId>
		<AssemblyName>Endfix.Telegram.BotAPI</AssemblyName>
		<RootNamespace>Endfix.Telegram.BotAPI</RootNamespace>
		<Authors>endfix</Authors>
		<Description>Low-level typed .NET client for the Telegram Bot API.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/endfix/telegram-bot-api</PackageProjectUrl>
		<RepositoryUrl>https://github.com/endfix/telegram-bot-api</RepositoryUrl>
		<PackageTags>telegram;bot;api</PackageTags>

		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<EnablePackageValidation>true</EnablePackageValidation>
		<!--
		  No baseline during the 2.0.0 major release: the ParseMode enum, the
		  StoryAreaPosition -> AreaPosition rename, and the optional chat_id
		  fields are intentional breaking changes. Restore
		  <PackageValidationBaselineVersion>2.0.0</PackageValidationBaselineVersion>
		  after 2.0.0 is published so that later releases keep the compatibility
		  check.
		-->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<IsPackable>true</IsPackable>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1584;CS1587;CS1591;CS1658;CS1710;CS1734;CS1735</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\icon.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="**/BotApiClientExtensions.*.cs">
			<DependentUpon>BotApiClientExtensions.cs</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="**/BotApiClient.*.cs">
			<DependentUpon>BotApiClient.cs</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Text.Json" Version="8.0.6" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
	</ItemGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="Telegram.BotAPI.Tests" />
	  <InternalsVisibleTo Include="Telegram.BotAPI.NetFrameworkSmoke" />
	</ItemGroup>

</Project>
