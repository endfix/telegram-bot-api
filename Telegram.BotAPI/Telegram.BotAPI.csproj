<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>12.0</LangVersion>
		<PackageId>Endfix.Telegram.BotAPI</PackageId>
		<AssemblyName>Endfix.Telegram.BotAPI</AssemblyName>
		<RootNamespace>Endfix.Telegram.BotAPI</RootNamespace>
		<Authors>endfix</Authors>
		<Description>Typed .NET client for the Telegram Bot API.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/endfix/telegram-bot-api</PackageProjectUrl>
		<RepositoryUrl>https://github.com/endfix/telegram-bot-api</RepositoryUrl>
		<PackageTags>telegram;bot;api</PackageTags>

		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IsPackable>true</IsPackable>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1584;CS1587;CS1591;CS1658;CS1710;CS1734;CS1735</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="**/BotApiClientExtensions.*.cs">
			<DependentUpon>BotApiClientExtensions.cs</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="**/BotApiClient.*.cs">
			<DependentUpon>BotApiClient.cs</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
	  <PackageReference Include="System.Text.Json" Version="10.0.11" />
	</ItemGroup>
	
</Project>
