<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<LangVersion>12.0</LangVersion>
		<PackageId>Endfix.Telegram.BotAPI</PackageId>
		<AssemblyName>Endfix.Telegram.BotAPI</AssemblyName>
		<RootNamespace>Endfix.Telegram.BotAPI</RootNamespace>
		<Authors>endfix</Authors>
		<Description>Low-level typed .NET client for the Telegram Bot API.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/endfix/telegram-bot-api</PackageProjectUrl>
		<RepositoryUrl>https://github.com/endfix/telegram-bot-api</RepositoryUrl>
		<PackageTags>telegram;bot;api</PackageTags>

		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<EnablePackageValidation>true</EnablePackageValidation>
		<!--
		  Validate every package against the last published line. Bump this only
		  after a release is on nuget.org; a major release then needs no
		  compatibility suppressions because the breaking members are part of
		  the new baseline.
		-->
		<PackageValidationBaselineVersion>3.0.0</PackageValidationBaselineVersion>
		<!--
		  The published 2.0.0 package shipped with AssemblyVersion 2.0.0.0. The
		  3.x line starts a new identity at 3.0.0.0; keep every 3.x release on
		  that identity so baselines never report an assembly version downgrade
		  and existing 3.x consumers keep the same binding.
		-->
		<AssemblyVersion>3.0.0.0</AssemblyVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<IsPackable>true</IsPackable>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1584;CS1587;CS1591;CS1658;CS1710;CS1734;CS1735</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\icon.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="**/BotApiClientExtensions.*.cs">
			<DependentUpon>BotApiClientExtensions.cs</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="**/BotApiClient.*.cs">
			<DependentUpon>BotApiClient.cs</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Text.Json" Version="8.0.6" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
	</ItemGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="Telegram.BotAPI.Tests" />
	  <InternalsVisibleTo Include="Telegram.BotAPI.NetFrameworkSmoke" />
	</ItemGroup>

</Project>
